#!/usr/bin/env bash
# Switch the colour theme everywhere: `theme <name>`, or `theme -h` to list the themes.
# Ghostty, Neovim, yazi and btop are switched here; tmux and fzf use the terminal's ANSI colours,
# so they follow Ghostty on their own.
#
# Adding a theme (say `gruvbox`):
#   1. Here: add it to `themes` below and a branch to the case statement setting
#        ghostty - a theme Ghostty ships (`ghostty +list-themes`) or a file in ghostty/themes/
#        yazi    - a flavor folder, yazi/flavors/<name>.yazi/ with flavor.toml (UI colours) and
#                  tmtheme.xml (code preview colours); copy nord.yazi and swap the colours.
#                  Avoid italics in either, tmux draws them as inverted colours
#        btop    - a .theme file: btop's bundled ones are in $(brew --prefix)/share/btop/themes,
#                  otherwise add one to btop/themes/ (rose-pine.theme shows the keys)
#   2. nvim/lua/utils/theme.lua: map the name to a colorscheme in `colorschemes`. If the
#      colorscheme is a new plugin, add its spec to nvim/lua/plugins/ (lazy = false, no setup)
#      and call its setup() in M.apply(), passing `transparent` to its transparency option
#   3. Nothing for tmux or fzf; check them after switching, since they use the Ghostty palette
set -euo pipefail

DOTFILES="$HOME/dotfiles"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/theme"

themes=(nord rosepine)

current=$(cat "$STATE" 2>/dev/null || echo nord)

usage() {
  echo "usage: theme <name>"
  echo
  echo "themes:"
  for name in "${themes[@]}"; do
    if [ "$name" = "$current" ]; then
      echo "  $name (current)"
    else
      echo "  $name"
    fi
  done
}

if [ $# -ne 1 ]; then
  usage >&2
  exit 1
fi

theme=$1

case "$theme" in
  -h | --help)
    usage
    exit 0
    ;;
  nord)
    ghostty="nord"
    yazi="nord"
    btop="${HOMEBREW_PREFIX:-/opt/homebrew}/share/btop/themes/nord.theme"
    ;;
  rosepine)
    ghostty="Rose Pine Moon"
    yazi="rose-pine"
    btop="$DOTFILES/btop/themes/rose-pine.theme"
    ;;
  *)
    echo "theme: unknown theme '$theme'" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac

mkdir -p "$(dirname "$STATE")"
echo "$theme" >"$STATE"

# generated files below are gitignored, so switching never dirties the repo
echo "theme = $ghostty" >"$DOTFILES/ghostty/current-theme"
printf '[flavor]\ndark = "%s"\nlight = "%s"\n' "$yazi" "$yazi" >"$DOTFILES/yazi/theme.toml"
ln -sfn "$btop" "$DOTFILES/btop/themes/current.theme"

# running Neovims re-read $STATE (utils/theme.lua). Dead sockets just fail, but an instance
# that never answers (e.g. a busy `nvim --embed`) would block forever, so each gets 2 seconds.
for sock in "${TMPDIR:-/tmp/}"nvim."$USER"/*/nvim.*.0; do
  [ -S "$sock" ] || continue
  nvim --server "$sock" --remote-expr 'luaeval("require(\"utils.theme\").apply()")' >/dev/null 2>&1 &
  pid=$!
  (sleep 2 && kill "$pid" 2>/dev/null) &
done
wait

echo "Switched to $theme. Reload Ghostty with Cmd-Shift-,"
