font-family = JetBrainsMono Nerd Font
font-size = 12

macos-titlebar-style = hidden

window-padding-x = 9
window-padding-y = 9
window-padding-balance = true

background-opacity = 0.85
background-blur = 10

# colours: themes/nord unless the `theme` script has written current-theme (gitignored)
theme = nord
config-file = ?current-theme
